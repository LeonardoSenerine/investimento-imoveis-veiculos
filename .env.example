# Copie para .env e preencha. Variáveis VITE_* são públicas (vão para o bundle).

# Domínio público do site, sem barra no final. Usado na capa de link (og:image).
# Ex.: https://chave.vercel.app
VITE_SITE_URL=

# Endpoint que recebe os cadastros (POST JSON). Vazio = modo demonstração.
VITE_LEAD_API_URL=

# WhatsApp com DDI + DDD, apenas dígitos. Ex.: 5511999999999
VITE_WHATSAPP_NUMBER=

# Google Tag Manager (ex.: GTM-XXXXXXX)
VITE_GTM_ID=

# Meta Pixel (apenas números). Não configure o Pixel também dentro do GTM,
# para evitar eventos duplicados.
VITE_META_PIXEL_ID=

# E-mail para solicitações de privacidade (opcional)
VITE_PRIVACY_EMAIL=
